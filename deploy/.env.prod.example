# ===========================================================================
# Leantime 生产环境变量模板（Docker Compose）
# 复制为 deploy/.env 后按需修改，切勿把真实密钥提交到仓库。
#
#   cp deploy/.env.prod.example deploy/.env
#   # 生成随机密钥：openssl rand -hex 32
# ===========================================================================

# ---- 站点 ----
# 3.11 起 LEAN_APP_URL 参与"受信 URL"机制：找回密码/邀请邮件中的链接只使用受信 URL
# （本值，或首次安装/首次 owner|admin 登录时记录的地址）；两者都没有时这类邮件不会发送。
# 生产环境务必设置本值。修改后也可执行：
#   php bin/leantime setting:save --key=system.trustedAppUrl --value=https://leantime.example.com
LEAN_APP_URL=https://leantime.example.com
LEAN_SITENAME=Leantime
LEAN_LANGUAGE=zh-CN
LEAN_DEFAULT_TIMEZONE=Asia/Shanghai
LEAN_DEBUG=0
LEAN_LOG_CHANNELS=stderr
LEAN_SOFT_RELOAD=true
# 每日匿名使用统计（计数/版本）上报 telemetry.leantime.io；false = 永不发送并隐藏该项设置
LEAN_ALLOW_TELEMETRY=false
# 可选：Unsplash 访问 key；设置后用户可在账户设置中选择 Unsplash 背景图，留空则仅允许上传图片
#LEAN_UNSPLASH_ACCESS_KEY=

# ---- 反向代理信任（3.11 语义变化，务必阅读）----
# 留空（推荐，默认 PRIVATE_SUBNETS）＝信任回环与私有网段（覆盖 Docker 网络内的 Caddy/Railway 边缘），
# 且不拒绝任何请求，仅决定相信哪些 X-Forwarded-* 头。
# 一旦显式设置，该列表同时充当访问白名单——不经过这些代理的请求将 403。
# 仅当代理/CDN 从公网地址连入（如 Cloudflare）时才列出其网段，例如：
# LEAN_TRUSTED_PROXIES=203.0.113.0/24,198.51.100.10
# REMOTE_ADDR 表示信任所有客户端（允许 IP 伪造，仅当应用无法被直连时使用）。切勿设置 '*'。
# 3.10 及更早的默认值 '127.0.0.1,REMOTE_ADDR' 已不再需要。

# ---- 数据库（PostgreSQL，默认）----
LEAN_DB_DEFAULT_CONNECTION=pgsql
LEAN_DB_HOST=db
LEAN_DB_PORT=5432
LEAN_DB_DATABASE=leantime
LEAN_DB_USER=leantime
LEAN_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
LEAN_DB_SCHEMA=public
LEAN_DB_PERSISTENT_CONNECTIONS=true

# ---- 数据库（MySQL 备选，需同步修改 docker-compose.prod.yml 的 db 服务）----
# LEAN_DB_DEFAULT_CONNECTION=mysql
# LEAN_DB_HOST=db
# LEAN_DB_PORT=3306
# LEAN_DB_DATABASE=leantime
# LEAN_DB_USER=leantime
# LEAN_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ---- Session（务必固定，否则每次重启都会掉登录）----
LEAN_SESSION_PASSWORD=CHANGE_ME_openssl_rand_hex_32
LEAN_SESSION_EXPIRATION=480
LEAN_SESSION_SECURE=true

# ---- Redis（session 与缓存）----
LEAN_USE_REDIS=true
LEAN_REDIS_HOST=redis
LEAN_REDIS_PORT=6379
LEAN_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
LEAN_REDIS_SCHEME=tcp
LEAN_REDIS_SESSION_DB=1

# ---- 邮件（可选）----
LEAN_EMAIL_RETURN=noreply@example.com
LEAN_EMAIL_USE_SMTP=false
# 发件人显示名（如 "Acme Projects"）；留空时显示 "Leantime"
LEAN_EMAIL_FROM_NAME=

# ---- 安全与限流（3.11 新增）----
# 跨站请求保护：拒绝来自其它站点的 POST/PUT/PATCH/DELETE（校验 Sec-Fetch-Site/Origin/Referer）。
# API-key/Bearer 请求豁免；仅在应急时临时关闭。
LEAN_CSRF_ORIGIN_CHECK=true
# 以下为默认值，一般无需设置（取消注释可显式覆盖）：
# LEAN_RATELIMIT_PASSWORD_RESET=5    # 找回密码 POST：每 IP 每 10 分钟
# LEAN_RATELIMIT_TWOFA=5             # 两步验证尝试：每用户每 5 分钟

# ---- 镜像标签（可选）----
LEAN_IMAGE_TAG=latest
