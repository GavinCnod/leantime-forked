# 构建镜像时排除的内容，避免把本地依赖和密钥打进镜像
.git
.github
.idea
.vscode
node_modules
vendor
public/dist
.docs
docs
tests
.phpstan
.phpdoc
.phive
*.log

# 运行时数据（镜像内会用 mkdir 重建）
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/*
userfiles/*
public/userfiles/*

# 密钥与本地配置，绝不进镜像
.env
.env.*
**/.env
**/.env.*
!**/.env.*.example
config/.env
